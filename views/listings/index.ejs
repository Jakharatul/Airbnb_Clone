<% layout("/layouts/boilerplate")%>

<body>
    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }
        .filter{
            text-align: center;
            margin-right: 2rem;
            margin-top: 2rem;
            opacity: 0.7;
        }
        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }
        .filter-link {
            text-decoration: none;
            color: inherit;
        }
        .filter-link:hover {
            color: inherit;
        }
        .active-filter .filter {
            opacity: 1;
            border-bottom: 2px solid #fe424d;
            padding-bottom: 0.2rem;
        }
        .tax-info{
            display: none;
        }
        .tax-toggle{
            border: 1px solid black;
            border-radius: 1rem;
            height: 3.25rem;
            padding: 1rem;
            margin-left: 2rem;
            display: flex;
            align-items: center;
        }
    </style>

<div id="filters">
    <% 
      const categories = [
        { name: "Trending", icon: "fa-solid fa-fire" },
        { name: "Rooms", icon: "fa-solid fa-bed" },
        { name: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
        { name: "Mountains", icon: "fa-solid fa-mountain" },
        { name: "Castles", icon: "fa-brands fa-fort-awesome" },
        { name: "Arctic", icon: "fa-solid fa-snowflake" },
        { name: "Camping", icon: "fa-solid fa-tents" },
        { name: "Farms", icon: "fa-solid fa-cow" },
        { name: "Domes", icon: "fa-solid fa-igloo" },
        { name: "Boats", icon: "fa-solid fa-sailboat" }
      ];
    %>

    <% for (let cat of categories) { %>
        <% 
            const isSelected = (typeof category !== 'undefined' && category && category.toLowerCase() === cat.name.toLowerCase());
            let filterUrl = isSelected ? '/listings' : `/listings?category=${encodeURIComponent(cat.name)}`;
        %>
        <a href="<%= filterUrl %>" class="filter-link <%= isSelected ? 'active-filter' : '' %>">
            <div class="filter">
                <div>
                    <i class="<%= cat.icon %>"></i>
                </div>
                <p><%= cat.name %></p>
            </div>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>

</div>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
        <% if (allListings.length === 0) { %>
            <div class="col-12 mt-4 mb-5 text-center">
                <h4>No listings found!</h4>
                <p class="text-muted">No listings match your filter or search criteria.</p>
                <a href="/listings" class="btn btn-outline-dark mt-2">Clear Filters</a>
            </div>
        <% } else { %>
            <% for(let listing of allListings){%>
            <a href="/listings/<%=listing._id %>" class="listing-links"> 
            <div class="card col listing-card">
             <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b><br>
                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>/night
                    <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                </p>
                </div>
            </div>
            </a>
            <% }%>
        <% } %>
    </div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
        for( info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
            
        }
    })
</script>
   


